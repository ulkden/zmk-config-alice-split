// Default keymap for poppy_split_v01.
// Bindings follow the matrix transform order: each line is one matrix row,
// 7 (or fewer) left-half keys, then the right-half keys.
// Island keys: left = last key of rows 1-2, right = first key of rows 2-3.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        // ,------------------------------------------------.   ,------------------------------------------------.
        // | ESC  |  1   |  2   |  3   |  4   |  5   |  6   |   |  7   |  8   |  9   |  0   |  -   |  =   | BSPC |
        // | TAB  |  Q   |  W   |  E   |  R   |  T   | PGUP |   |  Y   |  U   |  I   |  O   |  P   |  [   |  ]   |
        // | CAPS |  A   |  S   |  D   |  F   |  G   | PGDN |   | HOME |  H   |  J   |  K   |  L   |  ;   |  '   |
        // | SHFT |  Z   |  X   |  C   |  V   |  B   |      |   | END  |  N   |  M   |  ,   |  .   |  /   | SHFT |
        // | CTRL |                    | GUI  | FN   | SPC  |   | SPC  | ENT  | RALT |
        // `------------------------------------------------'   `--------------------'
        default_layer {
            display-name = "Base";
            bindings = <
                &kp ESC   &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6       &kp N7    &kp N8 &kp N9 &kp N0    &kp MINUS &kp EQUAL &kp BSPC
                &kp TAB   &kp Q  &kp W  &kp E  &kp R  &kp T  &kp PG_UP    &kp Y     &kp U  &kp I  &kp O     &kp P     &kp LBKT  &kp RBKT
                &kp CAPS  &kp A  &kp S  &kp D  &kp F  &kp G  &kp PG_DN    &kp HOME  &kp H  &kp J  &kp K     &kp L     &kp SEMI  &kp SQT
                &kp LSHFT &kp Z  &kp X  &kp C  &kp V  &kp B               &kp END   &kp N  &kp M  &kp COMMA &kp DOT   &kp FSLH  &kp RSHFT
                &kp LCTRL                      &kp LGUI &mo 1 &kp SPACE   &kp SPACE &kp RET &kp RALT
            >;
        };

        // ,------------------------------------------------.   ,------------------------------------------------.
        // |  `   |  F1  |  F2  |  F3  |  F4  |  F5  |  F6  |   |  F7  |  F8  |  F9  | F10  | F11  | F12  | DEL  |
        // |      |      |      |      |      |      |      |   |      |      |  UP  |      |      |      |  \   |
        // |STUDIO|      |      |      |      |      |      |   |      |      | LEFT | DOWN | RGHT |      |      |
        // | BOOT |      |      |      |      |      |      |   |      |      |      |      |      |      | BOOT |
        // |      |                    |      |      |      |   |      |      |      |
        // `------------------------------------------------'   `--------------------'
        // BOOT reboots the half it is pressed on into its UF2 bootloader.
        fn_layer {
            display-name = "Fn";
            bindings = <
                &kp GRAVE      &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6    &kp F7 &kp F8 &kp F9   &kp F10   &kp F11    &kp F12 &kp DEL
                &trans         &trans &trans &trans &trans &trans &trans    &trans &trans &kp UP   &trans    &trans     &trans  &kp BSLH
                &studio_unlock &trans &trans &trans &trans &trans &trans    &trans &trans &kp LEFT &kp DOWN  &kp RIGHT  &trans  &trans
                &bootloader    &trans &trans &trans &trans &trans           &trans &trans &trans   &trans    &trans     &trans  &bootloader
                &trans                       &trans &trans &trans           &trans &trans &trans
            >;
        };
    };
};
